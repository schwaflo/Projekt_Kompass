{
  "schemaVersion": "1.0",
  "meta": {
    "id": "demo-hell",
    "name": "Demo Hell",
    "beschreibung": "Helles, ruhiges Design mit Serifenschrift, viel Weißraum und einem einzigen Akzent in Orangerot. Alle Folien sind hell und linksbündig.",
    "version": "1.0.0",
    "autor": "Projekt-Kompass",
    "tags": ["hell", "minimalistisch", "editorial", "ruhig", "modern"]
  },
  "tokens": {
    "colors": {
      "primary": "#1C1B1A",
      "secondary": "#4A4541",
      "accent": "#C2410C",
      "background": "#FAF8F5",
      "surface": "#F0ECE6",
      "text": "#1C1B1A",
      "textMuted": "#6B6661",
      "success": "#2F7D4F",
      "warning": "#A65F00",
      "error": "#B3261E",
      "border": "#D8D2CA",
      "chartPalette": ["#1C1B1A", "#C2410C", "#8C8580", "#E8A87C", "#4A4541", "#C9C2B8"]
    },
    "typography": {
      "headingFont": "Fraunces",
      "bodyFont": "Work Sans",
      "headingFallback": ["Georgia", "Times New Roman", "serif"],
      "bodyFallback": ["Arial", "Helvetica", "sans-serif"],
      "googleFonts": true,
      "sizes": { "display": 80, "title": 48, "h1": 32, "quote": 34, "kpi": 50, "h2": 20, "body": 18, "small": 14, "caption": 12 },
      "lineHeight": 1.3,
      "headingBold": false
    },
    "spacing": { "marginX": 8, "marginY": 10, "gap": 4, "grid": { "columns": 12, "gutter": 2 } },
    "shapes": { "radius": 0, "lineWidth": 1, "shadow": "none" }
  },
  "masters": {
    "inhalt": {
      "background": "background",
      "deko": [
        { "shape": "rect", "x": 8, "y": 27, "w": 84, "h": 0.2, "fill": "border" }
      ],
      "placeholders": [
        { "id": "footer", "typ": "text", "auto": "presentationTitle", "x": 8, "y": 5, "w": 60, "h": 4.5, "style": { "size": "caption", "color": "textMuted", "valign": "middle", "uppercase": true } },
        { "id": "page", "typ": "text", "auto": "pageNumber", "x": 82, "y": 5, "w": 10, "h": 4.5, "style": { "size": "caption", "color": "textMuted", "align": "right", "valign": "middle" } }
      ]
    }
  },
  "layouts": [
    {
      "id": "title",
      "name": "Titelfolie",
      "beschreibung": "Erste Folie der Präsentation: Titel, Untertitel und eine Zeile für Anlass, Datum oder Vortragende.",
      "background": "background",
      "deko": [
        { "shape": "rect", "x": 8, "y": 40, "w": 3, "h": 5.3, "fill": "accent" }
      ],
      "placeholders": [
        { "id": "logo", "typ": "logo", "asset": "logo-primary", "x": 8, "y": 9, "w": 16, "h": 7.6, "fit": "contain" },
        { "id": "title", "typ": "text", "beschreibung": "Titel der Präsentation", "pflicht": true, "x": 8, "y": 48, "w": 72, "h": 26, "maxChars": 60, "style": { "font": "heading", "size": "title", "color": "text", "valign": "top" } },
        { "id": "subtitle", "typ": "text", "beschreibung": "Untertitel: worum es geht, in einem Satz", "x": 8, "y": 75, "w": 64, "h": 12, "maxChars": 110, "style": { "size": "h2", "color": "textMuted", "valign": "top" } },
        { "id": "meta", "typ": "text", "beschreibung": "Anlass, Datum oder Vortragende", "x": 52, "y": 10.5, "w": 40, "h": 5, "maxChars": 60, "style": { "size": "caption", "color": "textMuted", "align": "right", "valign": "middle", "uppercase": true } }
      ]
    },
    {
      "id": "section",
      "name": "Kapiteltrenner",
      "beschreibung": "Leitet einen neuen Abschnitt ein: Kapitelnummer, Kapiteltitel und ein kurzer Satz, was jetzt kommt.",
      "background": "surface",
      "placeholders": [
        { "id": "number", "typ": "text", "beschreibung": "Kapitelnummer, zum Beispiel 01", "x": 8, "y": 12, "w": 30, "h": 28, "maxChars": 2, "style": { "font": "heading", "size": "display", "color": "accent", "valign": "top" } },
        { "id": "title", "typ": "text", "beschreibung": "Kapiteltitel", "pflicht": true, "x": 8, "y": 50, "w": 76, "h": 22, "maxChars": 50, "style": { "font": "heading", "size": "title", "color": "text", "valign": "bottom" } },
        { "id": "subtitle", "typ": "text", "beschreibung": "Ein Satz zum Inhalt des Kapitels", "x": 8, "y": 75, "w": 64, "h": 13, "maxChars": 120, "style": { "size": "h2", "color": "textMuted", "valign": "top" } }
      ]
    },
    {
      "id": "content-bullets",
      "name": "Inhalt mit Aufzählung",
      "beschreibung": "Standardfolie: eine Aussage als Überschrift und bis zu fünf Stichpunkte. Für Argumente, Ergebnisse und Listen.",
      "master": "inhalt",
      "placeholders": [
        { "id": "title", "typ": "text", "beschreibung": "Überschrift als Aussage", "pflicht": true, "x": 8, "y": 11, "w": 84, "h": 15, "maxChars": 70, "style": { "font": "heading", "size": "h1", "color": "text", "valign": "bottom" } },
        { "id": "bullets", "typ": "bullets", "beschreibung": "Stichpunkte, jeder ein vollständiger Gedanke", "pflicht": true, "x": 8, "y": 32, "w": 70, "h": 58, "maxItems": 5, "maxCharsPerItem": 110, "style": { "size": "body", "color": "text", "bullet": "dash" } }
      ]
    },
    {
      "id": "two-column",
      "name": "Zwei Spalten",
      "beschreibung": "Stellt zwei Themen nebeneinander, zum Beispiel heute und künftig, Problem und Lösung, Option A und B.",
      "master": "inhalt",
      "placeholders": [
        { "id": "title", "typ": "text", "beschreibung": "Überschrift als Aussage", "pflicht": true, "x": 8, "y": 11, "w": 84, "h": 15, "maxChars": 70, "style": { "font": "heading", "size": "h1", "color": "text", "valign": "bottom" } },
        { "id": "leftTitle", "typ": "text", "beschreibung": "Titel der linken Spalte", "x": 8, "y": 32, "w": 39, "h": 7, "maxChars": 36, "style": { "size": "caption", "color": "accent", "bold": true, "uppercase": true, "valign": "middle" } },
        { "id": "leftBullets", "typ": "bullets", "beschreibung": "Stichpunkte links", "pflicht": true, "x": 8, "y": 41, "w": 39, "h": 49, "maxItems": 4, "maxCharsPerItem": 80, "style": { "size": "body", "color": "text", "bullet": "dash" } },
        { "id": "rightTitle", "typ": "text", "beschreibung": "Titel der rechten Spalte", "x": 53, "y": 32, "w": 39, "h": 7, "maxChars": 36, "style": { "size": "caption", "color": "accent", "bold": true, "uppercase": true, "valign": "middle" } },
        { "id": "rightBullets", "typ": "bullets", "beschreibung": "Stichpunkte rechts", "pflicht": true, "x": 53, "y": 41, "w": 39, "h": 49, "maxItems": 4, "maxCharsPerItem": 80, "style": { "size": "body", "color": "text", "bullet": "dash" } }
      ]
    },
    {
      "id": "image-left",
      "name": "Bild links, Text rechts",
      "beschreibung": "Hochformatiges Bild links mit Rand, rechts Überschrift und Stichpunkte. Für Folien, die ein Thema anschaulich machen.",
      "background": "background",
      "placeholders": [
        { "id": "image", "typ": "image", "beschreibung": "Hochformatiges Bild", "asset": "portrait-image", "x": 8, "y": 10, "w": 32, "h": 80, "fit": "cover" },
        { "id": "title", "typ": "text", "beschreibung": "Überschrift als Aussage", "pflicht": true, "x": 46, "y": 10, "w": 46, "h": 26, "maxChars": 60, "style": { "font": "heading", "size": "h1", "color": "text", "valign": "bottom" } },
        { "id": "bullets", "typ": "bullets", "beschreibung": "Stichpunkte", "pflicht": true, "x": 46, "y": 41, "w": 46, "h": 49, "maxItems": 4, "maxCharsPerItem": 90, "style": { "size": "body", "color": "text", "bullet": "dash" } }
      ]
    },
    {
      "id": "image-full",
      "name": "Großes Bild",
      "beschreibung": "Ein Bild füllt die oberen zwei Drittel der Folie, darunter eine kurze Aussage. Für emotionale Momente und starke Einstiege.",
      "background": "background",
      "placeholders": [
        { "id": "image", "typ": "image", "beschreibung": "Querformatiges Bild", "asset": "hero-image", "x": 0, "y": 0, "w": 100, "h": 64, "fit": "cover" },
        { "id": "title", "typ": "text", "beschreibung": "Kurze, starke Aussage", "pflicht": true, "x": 8, "y": 68, "w": 84, "h": 14, "maxChars": 60, "style": { "font": "heading", "size": "h1", "color": "text", "valign": "middle" } },
        { "id": "caption", "typ": "text", "beschreibung": "Ein erklärender Satz", "x": 8, "y": 83, "w": 76, "h": 10, "maxChars": 120, "style": { "size": "h2", "color": "textMuted", "valign": "top" } }
      ]
    },
    {
      "id": "kpi-grid",
      "name": "Kennzahlen",
      "beschreibung": "Zwei bis vier Kennzahlen groß nebeneinander, jede mit kurzer Erklärung. Nur verwenden, wenn echte Zahlen vorliegen.",
      "master": "inhalt",
      "placeholders": [
        { "id": "title", "typ": "text", "beschreibung": "Überschrift als Aussage", "pflicht": true, "x": 8, "y": 11, "w": 84, "h": 15, "maxChars": 70, "style": { "font": "heading", "size": "h1", "color": "text", "valign": "bottom" } },
        { "id": "kpis", "typ": "items", "beschreibung": "Kennzahlen", "pflicht": true, "x": 8, "y": 36, "w": 84, "h": 36, "minItems": 2, "maxItems": 4, "variante": "schlicht",
          "felder": [
            { "id": "value", "beschreibung": "Die Zahl mit Einheit, zum Beispiel 42 % oder 1,2 Mio.", "maxChars": 9, "anteil": 58, "style": { "font": "heading", "size": "kpi", "color": "accent", "valign": "bottom" } },
            { "id": "label", "beschreibung": "Was die Zahl bedeutet", "maxChars": 48, "anteil": 42, "style": { "size": "small", "color": "textMuted", "valign": "top" } }
          ] },
        { "id": "note", "typ": "text", "beschreibung": "Quelle oder Einordnung der Zahlen", "x": 8, "y": 80, "w": 84, "h": 10, "maxChars": 140, "style": { "size": "small", "color": "textMuted", "valign": "top" } }
      ]
    },
    {
      "id": "timeline",
      "name": "Zeitstrahl",
      "beschreibung": "Drei bis fünf Schritte in zeitlicher Reihenfolge, zum Beispiel Projektphasen, Meilensteine oder nächste Schritte.",
      "master": "inhalt",
      "placeholders": [
        { "id": "title", "typ": "text", "beschreibung": "Überschrift als Aussage", "pflicht": true, "x": 8, "y": 11, "w": 84, "h": 15, "maxChars": 70, "style": { "font": "heading", "size": "h1", "color": "text", "valign": "bottom" } },
        { "id": "steps", "typ": "items", "beschreibung": "Schritte in zeitlicher Reihenfolge", "pflicht": true, "x": 8, "y": 36, "w": 84, "h": 52, "minItems": 3, "maxItems": 5, "variante": "zeitstrahl",
          "felder": [
            { "id": "label", "beschreibung": "Zeitangabe, zum Beispiel Q1 oder März", "maxChars": 12, "anteil": 20, "style": { "size": "caption", "color": "accent", "bold": true, "uppercase": true, "valign": "bottom" } },
            { "id": "title", "beschreibung": "Name des Schritts", "maxChars": 28, "anteil": 30, "style": { "font": "heading", "size": "h2", "color": "text", "valign": "top" } },
            { "id": "text", "beschreibung": "Was in diesem Schritt passiert", "maxChars": 70, "anteil": 50, "style": { "size": "small", "color": "textMuted", "valign": "top" } }
          ] }
      ]
    },
    {
      "id": "quote",
      "name": "Zitat",
      "beschreibung": "Ein Zitat oder eine Kernaussage groß in der Mitte, darunter die Quelle. Höchstens einmal pro Präsentation.",
      "background": "background",
      "deko": [
        { "shape": "rect", "x": 47, "y": 16, "w": 6, "h": 0.5, "fill": "accent" }
      ],
      "placeholders": [
        { "id": "quote", "typ": "text", "beschreibung": "Das Zitat ohne Anführungszeichen", "pflicht": true, "x": 14, "y": 22, "w": 72, "h": 46, "maxChars": 180, "style": { "font": "heading", "size": "quote", "color": "text", "align": "center", "valign": "middle", "italic": true } },
        { "id": "author", "typ": "text", "beschreibung": "Von wem das Zitat stammt", "x": 14, "y": 72, "w": 72, "h": 7, "maxChars": 60, "style": { "size": "caption", "color": "textMuted", "align": "center", "valign": "middle", "uppercase": true } }
      ]
    },
    {
      "id": "closing",
      "name": "Abschlussfolie",
      "beschreibung": "Letzte Folie: Dank oder Schlussgedanke, die Handlungsaufforderung und eine Kontaktzeile.",
      "background": "background",
      "deko": [
        { "shape": "rect", "x": 8, "y": 79, "w": 84, "h": 0.2, "fill": "border" }
      ],
      "placeholders": [
        { "id": "title", "typ": "text", "beschreibung": "Schlussgedanke oder Dank", "pflicht": true, "x": 8, "y": 14, "w": 76, "h": 30, "maxChars": 50, "style": { "font": "heading", "size": "title", "color": "text", "valign": "bottom" } },
        { "id": "body", "typ": "text", "beschreibung": "Handlungsaufforderung: was das Publikum jetzt tun soll", "x": 8, "y": 48, "w": 64, "h": 24, "maxChars": 160, "style": { "size": "h2", "color": "textMuted", "valign": "top" } },
        { "id": "contact", "typ": "text", "beschreibung": "Kontaktzeile: Name, E-Mail oder Website", "x": 8, "y": 83, "w": 56, "h": 7.6, "maxChars": 80, "style": { "size": "body", "color": "text", "valign": "middle" } },
        { "id": "logo", "typ": "logo", "asset": "logo-primary", "x": 76, "y": 83, "w": 16, "h": 7.6, "fit": "contain" }
      ]
    }
  ],
  "assets": [
    { "id": "logo-primary", "file": "assets/logos/logo-primary.svg", "role": "logo-primary", "w": 600, "h": 160, "tags": ["logo", "hell"], "beschreibung": "Hauptlogo für helle Hintergründe", "verwendung": ["title", "closing"] },
    { "id": "logo-negative", "file": "assets/logos/logo-negative.svg", "role": "logo-negative", "w": 600, "h": 160, "tags": ["logo", "dunkel"], "beschreibung": "Helles Logo für dunkle Hintergründe, in diesem System nicht verbaut", "verwendung": [] },
    { "id": "logo-icon", "file": "assets/logos/logo-icon.svg", "role": "logo-icon", "w": 256, "h": 256, "tags": ["logo", "bildmarke"], "beschreibung": "Bildmarke ohne Schriftzug, in diesem System nicht verbaut", "verwendung": [] },
    { "id": "hero", "file": "assets/images/hero.svg", "role": "hero-image", "w": 1920, "h": 1080, "tags": ["hero", "querformat", "stimmung"], "beschreibung": "Großes Stimmungsbild im Querformat", "verwendung": ["image-full"] },
    { "id": "portrait", "file": "assets/images/portrait.svg", "role": "portrait-image", "w": 1280, "h": 1800, "tags": ["hochformat", "detail"], "beschreibung": "Bild im Hochformat", "verwendung": ["image-left"] },
    { "id": "square", "file": "assets/images/square.svg", "role": "square-image", "w": 1200, "h": 1200, "tags": ["quadrat", "detail"], "beschreibung": "Quadratisches Bild, als Ausschnitt auch für image-left nutzbar", "verwendung": ["image-left"] }
  ],
  "rules": {
    "logoAuf": ["title", "closing"],
    "maxBullets": 5,
    "bildstil": "Helle, ruhige Fotos mit viel freier Fläche und natürlichem Licht. Lieber ein Detail als eine volle Szene.",
    "hinweise": [
      "Wenig Text pro Folie, lieber eine Folie mehr.",
      "Der Akzent wird sparsam eingesetzt: höchstens ein orangeroter Blickfang pro Folie."
    ]
  }
}
